!sentinel/gateway/requirements.txt
!sentinel/gateway/app.py
!sentinel/gateway/docker_start.py
!sentinel/gateway/model/
!sentinel/gateway/model/*
sentinel/gateway/model/__pycache__/
!sentinel/analysis/
!sentinel/analysis/api-extension/
