{
  "platform": "shopware",
  "source_contract": "sentinel/analysis/api-contracts/shopware/storeapi.json",
  "source_sha256": "97d434d38bb669b9ffdc098fc68a29d2dcc8d23a28999e485e24ee1f17c338bb",
  "source_info_version": "6.7.9999999-dev",
  "method": "GET",
  "path": "/checkout/gateway",
  "operation": {
    "tags": [
      "Gateway"
    ],
    "summary": "Call the checkout gateway",
    "description": "Call the checkout gateway, which is used to manipulate certain aspects of the checkout process (e.g. available payment methods).",
    "operationId": "checkoutGateway",
    "responses": {
      "200": {
        "description": "Checkout gateway response",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "payments",
                "shipments",
                "errors"
              ],
              "properties": {
                "payments": {
                  "description": "Payment methods that are available after the gateway ran.",
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PaymentMethod"
                  }
                },
                "shipments": {
                  "description": "Shipping methods that are available after the gateway ran.",
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ShippingMethod"
                  }
                },
                "errors": {
                  "description": "Cart errors added by the gateway. An empty list is returned as `[]`, otherwise the errors are keyed by their id.",
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CartError"
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/CartError"
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "401": {
        "$ref": "#/components/responses/401",
        "description": "The `sw-access-key` header is missing."
      }
    },
    "security": [
      {
        "ApiKey": []
      }
    ],
    "parameters": [
      {
        "name": "orderId",
        "in": "query",
        "description": "Evaluates the availability for this order of the current customer instead of the current session.",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      {
        "$ref": "#/components/parameters/swLanguageId"
      },
      {
        "$ref": "#/components/parameters/swContextSource"
      }
    ]
  },
  "effective_security": [
    {
      "ApiKey": []
    }
  ],
  "path_parameters": [],
  "servers": [
    {
      "url": "/store-api"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "description": "Identifies the sales channel you want to access the API through",
        "name": "sw-access-key",
        "in": "header"
      }
    },
    "parameters": {
      "swContextSource": {
        "name": "sw-context-source",
        "in": "header",
        "description": "Set to `session` to resolve the context from the storefront session cookie instead of a context token. Mutually exclusive with `sw-context-token`: sending both fails with HTTP 400 and `FRAMEWORK__ROUTING_SESSION_CONTEXT_NOT_RESOLVABLE`, as does a session that cannot be resumed.",
        "required": false,
        "schema": {
          "type": "string",
          "const": "session"
        }
      },
      "swLanguageId": {
        "name": "sw-language-id",
        "in": "header",
        "description": "Instructs Shopware to return the response in the given language.",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
