  "source_info_version": "2.4.10",
  "method": "POST",
  "path": "/customers",
  "operation": {
    "operationId": "api_apishopcustomers_post",
    "tags": [
      "Customer"
    ],
    "responses": {
      "201": {
        "description": "Customer registered. `token` is the Bearer token for subsequent calls.",
        "content": {
          "application/json": {}
        },
        "links": []
      },
      "422": {
        "description": "Validation failed (email already taken, passwords do not match, etc.).",
        "links": []
      },
      "400": {
        "description": "Invalid input",
        "links": []
      }
    },
    "summary": "Register a new customer",
    "description": "Register a new customer account",
    "parameters": [
      {
        "name": "X-STOREFRONT-KEY",
        "in": "header",
        "description": "Storefront API Key for authentication. Required for all shop/storefront API requests.",
        "required": true,
        "deprecated": false,
        "allowEmptyValue": false,
        "schema": {
          "type": "string"
        },
        "style": "simple",
        "explode": false
      },
      {
        "name": "X-Locale",
        "in": "header",
        "description": "Locale code for localized data (e.g. \"en\", \"fr\", \"ar\"). Defaults to channel's default locale.",
        "required": false,
        "deprecated": false,
        "allowEmptyValue": false,
        "schema": {
          "type": "string"
        },
        "style": "simple",
        "explode": false
      },
      {
        "name": "X-Channel",
        "in": "header",
        "description": "Channel code (e.g. \"default\"). Defaults to the current channel.",
        "required": false,
        "deprecated": false,
        "allowEmptyValue": false,
        "schema": {
          "type": "string"
        },
        "style": "simple",
        "explode": false
      },
      {
        "name": "X-Currency",
        "in": "header",
        "description": "Currency code (e.g. \"USD\", \"EUR\", \"INR\"). Defaults to channel's base currency.",
        "required": false,
        "deprecated": false,
        "allowEmptyValue": false,
        "schema": {
          "type": "string"
        },
        "style": "simple",
        "explode": false
      }
    ],
    "requestBody": {
      "description": "Customer registration data",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": [
              "firstName",
              "lastName",
              "email",
              "password",
              "confirmPassword"
            ],
            "properties": {
              "firstName": {
                "type": "string"
              },
              "lastName": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "password": {
                "type": "string",
                "format": "password"
              },
              "confirmPassword": {
                "type": "string",
                "format": "password"
              },
              "phone": {
                "type": "string"
              },
              "gender": {
                "type": "string",
                "enum": [
                  "Male",
                  "Female",
                  "Other"
                ]
              },
              "dateOfBirth": {
                "type": "string",
                "format": "date"
              },
              "status": {
                "type": "integer",
                "description": "Customer status (1 = active, 0 = inactive)"
              },
              "isVerified": {
                "type": "integer",
                "description": "Whether the customer is verified (1 = verified, 0 = not verified)"
              },
              "isSuspended": {
                "type": "integer",
                "description": "Whether the customer is suspended (1 = suspended, 0 = active)"
              },
              "subscribedToNewsLetter": {
                "type": "boolean"
              },
              "deviceToken": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": false
    }
  },
  "effective_security": [
    {
      "bearerAuth": []
    }
  ],
  "path_parameters": [],
  "servers": [
    {
      "url": "{url}/api/shop",
      "description": "Bagisto Shop API",
      "variables": {
        "url": {
          "default": "http://localhost:8000",
          "description": "Base URL of your Bagisto installation."
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "description": "Value for the http bearer parameter.",
        "scheme": "bearer",
        "bearerFormat": "UUID"
      }
    }
  }
