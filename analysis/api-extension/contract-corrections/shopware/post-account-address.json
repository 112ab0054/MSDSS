      "CustomerAddressBody": {
        "description": "Added since version: 6.0.0.0",
        "required": [
          "countryId",
          "firstName",
          "lastName",
          "zipcode",
          "city",
          "street"
        ],
        "properties": {
          "countryId": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "countryStateId": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
